--- !u!114 &1730703766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1730703762}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f34f36451b093ee4c83ad4aa5459d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textMPComponent: {fileID: 1730703764}
  uniqueFontTMP: {fileID: 0}
  textLComponent: {fileID: 0}
  infoYG: {fileID: 11400000, guid: 162644796a8b0d044bce3d6fda0641e3, type: 2}
  text: 
  ru: "\u041A\u0430\u043A \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u0440\u0435\u0439\u0442\u0438\u043D\u0433\r\n\r\n\u2022
    \u041E\u0447\u043A\u0438 \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u043B\u0438\u0434\u0435\u0440\u043E\u0432
    \u0437\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0437\u0430 \u0443\u0440\u043E\u0432\u043D\u0438, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 3 \u0437\u0432\u0435\u0437\u0434\u044B\r\n\u2022 \u041A\u0430\u0436\u0434\u044B\u0439
    \u0442\u0430\u043A\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
    \u043E\u0434\u043D\u043E \u043E\u0447\u043A\u043E\r\n\u2022 \u0427\u0435\u043C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0445
    \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0439, \u0442\u0435\u043C
    \u0432\u044B\u0448\u0435 \u0432\u0430\u0448\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044F\r\n\r\n\u0421\u043E\u0432\u0435\u0442:
    \u041F\u0435\u0440\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
    \u0443\u0440\u043E\u0432\u043D\u0438, \u0447\u0442\u043E\u0431\u044B \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0438 \u043E\u0431\u043E\u0433\u043D\u0430\u0442\u044C
    \u0434\u0440\u0443\u0437\u0435\u0439!"
  en: "How the rating system works\r\n\r\n\u2022 Points are added to the leaderboard
    only for levels completed with 3 stars\r\n\u2022 Each such level earns one point\r\n\u2022
    The more perfect completions you have, the higher your position\r\n\r\nTip: Replay
    levels to improve your result and beat your friends!"
  tr: "S\u0131ralama nas\u0131l \xE7al\u0131\u015F\u0131r?\r\n\r\n\u2022 Liderlik
    tablosuna puanlar yaln\u0131zca 3 y\u0131ld\u0131zla tamamlanan seviyeler i\xE7in
    verilir.\r\n\u2022 Her b\xF6yle bir seviye bir puan kazand\u0131r\u0131r.\r\n\u2022
    Ne kadar \xE7ok m\xFCkemmel tamamlama yaparsan\u0131z, pozisyonunuz o kadar y\xFCkselir.\r\n\r\n\u0130pucu:
    Sonucu iyile\u015Ftirmek ve arkada\u015Flar\u0131n\u0131z\u0131 ge\xE7mek i\xE7in
    seviyeleri tekrar oynay\u0131n!"
  az: 
  be: 
  he: 
  hy: 
