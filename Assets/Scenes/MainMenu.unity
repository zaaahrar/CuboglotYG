  _errorController: {fileID: 642803098}
  _errorTextRU: "\u0410\u0432\u0442\u043E\u0440\u0438\u0437\u0443\u0439\u0442\u0435\u0441\u044C,
    \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0439\u0442\u0438\u043D\u0433!\r\n\r\n\u0427\u0442\u043E\u0431\u044B
    \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0443
    \u043B\u0438\u0434\u0435\u0440\u043E\u0432 \u0438 \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0438\u0433\u0440\u043E\u043A\u0430\u043C\u0438,
    \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0430\u0432\u0442\u043E\u0440\u0438\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0441\u0435\u0440\u0432\u0438\u0441\u0435."
  _errorTextEN: 'Sign in to see the leaderboard!



    To get on the leaderboard
    and compete with other players, you need to sign in to the service.'
  _errorTextTR: "Liderlik tablosunu g\xF6rmek i\xE7in giri\u015F yap\u0131n!\r\n\r\nLiderlik
    tablosuna girmek ve di\u011Fer oyuncularla rekabet etmek i\xE7in hizmete giri\u015F
    yapman\u0131z gerekiyor."
